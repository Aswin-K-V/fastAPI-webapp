# Required
DATABASE_URL=sqlite+aiosqlite:///./app.db
SECRET_KEY=change-me-to-a-long-random-secret

# JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# App behavior
MAX_UPLOAD_SIZE_BYTES=5242880
POSTS_PER_PAGE=5
RESET_TOKEN_EXPIRE_MINUTES=60
FRONTEND_URL=http://localhost:8000

# SMTP password reset email
MAIL_SERVER=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_USE_TLS=true

# Optional S3 or S3-compatible profile image storage
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=logs
LOG_FILE_NAME=app.log
LOG_TO_FILE=true
LOG_TO_CONSOLE=true
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_REQUESTS=true
LOG_UVICORN_ACCESS=true
